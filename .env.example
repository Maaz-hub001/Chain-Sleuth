# ChainSleuth Environment Configuration Template
# Copy this file to .env and configure as needed for local or production deployment.

# ==========================================
# Service URLs & Ports
# ==========================================
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# ==========================================
# Database Configuration
# Uses SQLite for zero-config local run, or PostgreSQL for production / Docker.
# Example PostgreSQL: postgresql://chainsleuth:chainsleuth_pass@localhost:5432/chainsleuth_db
# ==========================================
DATABASE_URL=sqlite:///./chainsleuth.db

# ==========================================
# Blockchain Providers (EVM)
# Public RPC endpoints or custom Infura/Alchemy/QuickNode RPCs
# ==========================================
EVM_RPC_URL=https://rpc.ankr.com/eth
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=1

# Block Explorer APIs (Etherscan, Blockscout)
# Optional: if left blank, ChainSleuth uses public Blockscout API & RPC fallback with graceful degradation.
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/api
BLOCKSCOUT_API_URL=https://eth.blockscout.com/api

# ==========================================
# AI & LLM Provider Configuration
# Supported providers: "heuristic" (default, free offline expert synthesis),
# "openai", "gemini", "anthropic", "ollama"
# ==========================================
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==========================================
# Embedding & RAG Configuration
# Providers: "hybrid_local" (built-in BM25 + cosine, zero dependency), "openai"
# Vector Store: "in_memory" (default), "qdrant"
# ==========================================
EMBEDDING_PROVIDER=hybrid_local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=in_memory
QDRANT_URL=http://localhost:6333

# ==========================================
# Smart Contract & Report Integrity
# Optional: deployed address on testnet for on-chain anchoring
# ==========================================
REPORT_REGISTRY_ADDRESS=
REPORT_ANCHOR_RPC_URL=https://rpc.ankr.com/eth_sepolia
REPORT_ANCHOR_PRIVATE_KEY=
